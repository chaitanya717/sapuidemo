<mvc:View
    controllerName="sds.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
>
    <Page
        id="page1"
        titleAlignment="Center"
        title="Sales Customer App"
    >
        <Panel id="pn1">
            <Text
                id="txt1"
                text="Sales Customer CRUDQ "
            />
        </Panel>
        <ScrollContainer
            id="scr1"
            vertical="true"
            horizontal="true"
        >
            <Table
                id="tb1"
                growing="true"
                growingThreshold="100"
                items="{JsonPo>/sales_data}"
            >
                <headerToolbar>
                    <Toolbar  id="tlb1">
                        <Button
                            id="btntbl"
                            text="Add Record"
                            type="Emphasized"
                            press="AddRecord"
                            icon="sap-icon://add"
                        />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column
                        width="10rem"
                        id="col1"
                    >
                        <Label
                            id="lb1"
                            text="Kunnr"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col2"
                    >
                        <Label
                            id="lb2"
                            text="Land1"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col3"
                    >
                        <Label
                            id="lb3"
                            text="Name1"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col4"
                    >
                        <Label
                            id="lb4"
                            text="Name2"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col5"
                    >
                        <Label
                            id="lb5"
                            text="Ort01"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col6"
                    >
                        <Label
                            id="lb6"
                            text="Pstlz"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col7"
                    >
                        <Label
                            id="lb7"
                            text="Regio"
                        />
                    </Column>

                    <Column
                        width="10rem"
                        id="col8"
                    >
                        <Label
                            id="lb8"
                            text="Sortl"
                        />
                    </Column>
                    <Column
                        width="10rem"
                        id="col83"
                    >
                        <Label
                            id="lb83"
                            text="Action"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="cl1">
                        <cells>
                            <Text
                                id="kunnr"
                                text="{JsonPo>Kunnr}"
                            />
                            <Text
                                id="land1"
                                text="{JsonPo>Land1}"
                            />
                            <Text
                                id="name1"
                                text="{JsonPo>Name1}"
                            />
                            <Text
                                id="name2"
                                text="{JsonPo>Name2}"
                            />
                            <Text
                                id="ort01"
                                text="{JsonPo>Ort01}"
                            />
                            <Text
                                id="pstlz"
                                text="{JsonPo>Pstlz}"
                            />
                            <Text
                                id="regio"
                                text="{JsonPo>Regio}"
                            />
                            <Text
                                id="sortl"
                                text="{JsonPo>Sortl}"
                            />
                            <HBox id="hbox1">
                                <Button
                                    id="delete"
                                    icon="sap-icon://delete"
                                    press="deleteRecord"
                                    type="Reject"
                                    text="Remove"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="edit"
                                    icon="sap-icon://edit"
                                    press="editRecord"
                                    type="Emphasized"
                                    text="Edit"
                                    class="sapUiTinyMarginStart"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>
    </Page>
</mvc:View>
