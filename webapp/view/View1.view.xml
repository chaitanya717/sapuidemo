<mvc:View
    controllerName="sds.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
>
    <Page
        id="page1"
        titleAlignment="Center"
        title="Sales App SAPUI"
    >
    <Panel id="pnl1" headerText="Employee Details" expandable="false" >
        <content>
           <l:Grid id="grd1" defaultSpan="L3 M3" vSpacing="0">
           <l:content>
           <Label class="sapUiTinyMarginTop" id="empname" text="Employee Name" required="true" ></Label>
           <Input id="inp1" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empid" text="Employee ID" required="true" ></Label>
           <Input id="inp2" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empage" text="Employee Age" required="true" ></Label>
           <Input id="inp3" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empmbl" text="Employee Mobile" required="true" ></Label>
           <Input id="inp4" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empemail" text="Employee Email" required="true" ></Label>
           <Input id="inp5" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empcomp" text="Employee Company" required="true" ></Label>
           <Input id="inp6" required="true" ></Input>
           </l:content>
           </l:Grid>
        </content>

        </Panel>
         <Panel id="pnl2" headerText="Employee Details" expandable="false" >
        <content>
           <l:Grid id="grd2" defaultSpan="L6 M6" vSpacing="0">
           <l:content>
           <Label class="sapUiTinyMarginTop" id="empname2" text="Employee Name" required="true" ></Label>
           <Input id="inp21" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empid2" text="Employee ID" required="true" ></Label>
           <Input id="inp22" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empage2" text="Employee Age" required="true" ></Label>
           <Input id="inp23" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empmbl2" text="Employee Mobile" required="true" ></Label>
           <Input id="inp24" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empemail2" text="Employee Email" required="true" ></Label>
           <Input id="inp25" required="true" ></Input>

           <Label class="sapUiTinyMarginTop" id="empcomp2" text="Employee Company" required="true" ></Label>
           <Input id="inp26" required="true" ></Input>
           </l:content>
           </l:Grid>
        </content>
        </Panel>

         <Panel id="pnl3" headerText="Employee Details" expandable="false" >
        <content>
           <l:Grid id="grd3" >
           <l:content>

           <Label class="sapUiTinyMarginTop" id="empname3" text="Employee Name" required="true" >
           <layoutData>
           <l:GridData id="grdd3" span="L6 M6"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp31" required="true" >
            <layoutData>
           <l:GridData id="grdd4" span="L6 M6"></l:GridData>
           </layoutData>
           </Input>

           <Label class="sapUiTinyMarginTop" id="empid3" text="Employee ID" required="true" >
           <layoutData>
           <l:GridData id="5" span="L3 M3"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp32" required="true" >
            <layoutData>
           <l:GridData id="6" span="L3 M3"></l:GridData>
           </layoutData>
           </Input>

           <Label class="sapUiTinyMarginTop" id="empage3" text="Employee Age" required="true" >
            <layoutData>
           <l:GridData id="7" span="L3 M3"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp33" required="true" >
            <layoutData>
           <l:GridData id="8" span="L3 M3"></l:GridData>
           </layoutData>
           </Input>

           <Label class="sapUiTinyMarginTop" id="empmbl3" text="Employee Mobile" required="true" >
            <layoutData>
           <l:GridData id="9" span="L3 M3"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp34" required="true" >
            <layoutData>
           <l:GridData id="10" span="L3 M3"></l:GridData>
           </layoutData>
           </Input>

           <Label class="sapUiTinyMarginTop" id="empemail3" text="Employee Email" required="true" >
            <layoutData>
           <l:GridData id="11" span="L3 M3"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp35" required="true" >
            <layoutData>
           <l:GridData id="12" span="L3 M3"></l:GridData>
           </layoutData>
           </Input>

           <Label class="sapUiTinyMarginTop" id="empcomp3" text="Employee Company" required="true" >
            <layoutData>
           <l:GridData id="13" span="L6 M6"></l:GridData>
           </layoutData>
           </Label>

           <Input id="inp36" required="true" >
            <layoutData>
           <l:GridData id="14" span="L6 M6"></l:GridData>
           </layoutData>
           </Input>

           </l:content>
           </l:Grid>
        </content>
        </Panel>
        
        <footer>
            <Bar id="_IDGenBar">
                <contentRight>
                    <Button
                        id="save1"
                        type="Emphasized"
                        text="Save"
                    />
                    <Button
                        id="save2"
                        type="Reject"
                        text="Cancel"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
